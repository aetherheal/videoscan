# LLM backend. Defaults to Anthropic, which requires ANTHROPIC_API_KEY.
# Set to codex to run all three model calls through `codex exec` authenticated
# by the local ChatGPT subscription; no OPENAI_API_KEY is used.
VIDEOSCAN_PROVIDER=anthropic

# Anthropic API key for Layer 4 (editorial judgment), required only when
# VIDEOSCAN_PROVIDER=anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# Model used by Layer 4 (and the notes summarizer). Defaults to claude-opus-5.
# To run cheaper, set this to claude-sonnet-5 (and re-calibrate the virality
# threshold). Must be a model that supports adaptive thinking + output_config
# effort — pre-4.6 models (e.g. claude-haiku-4-5) reject both and will 400.
VIDEOSCAN_MODEL=claude-opus-5

# Model used by the high-volume footage catalog. Defaults to claude-sonnet-5.
VIDEOSCAN_CATALOG_MODEL=claude-sonnet-5

# Model used by Codex CLI when VIDEOSCAN_PROVIDER=codex. This one model serves
# Layer 4, the catalog, and the notes summarizer.
VIDEOSCAN_CODEX_MODEL=gpt-5.6-sol

# Per-call Codex CLI timeout in milliseconds. Vision catalog calls with many
# keyframes can take a while; defaults to 15 minutes.
VIDEOSCAN_CODEX_TIMEOUT_MS=900000

# Whisper model for Layer 3 ASR. large-v3 per the spec; word_timestamps are required.
VIDEOSCAN_WHISPER_MODEL=large-v3

# Path to the python interpreter that has faster-whisper installed.
# Defaults to python/.venv/bin/python if present, else `python3`.
VIDEOSCAN_PYTHON=
