# Anthropic API key for Layer 4 (editorial judgment).
ANTHROPIC_API_KEY=sk-ant-...

# Model used by Layer 4. Defaults to claude-opus-5.
# The Layer 4 spec mentions a "cost-optimized cron model" — to run cheaper,
# set this to claude-haiku-4-5 (and re-calibrate the virality threshold).
VIDEOSCAN_MODEL=claude-opus-5

# Model used by the high-volume footage catalog. Defaults to claude-sonnet-5.
VIDEOSCAN_CATALOG_MODEL=claude-sonnet-5

# Whisper model for Layer 3 ASR. large-v3 per the spec; word_timestamps are required.
VIDEOSCAN_WHISPER_MODEL=large-v3

# Path to the python interpreter that has faster-whisper installed.
# Defaults to python/.venv/bin/python if present, else `python3`.
VIDEOSCAN_PYTHON=
